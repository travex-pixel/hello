# ---------------------------------------------------------------------------
# HELLO — environment
# Nothing here is required. With no variables set, the app runs the AI demo
# with the local conversation engine and real-people mode reports itself as
# unavailable.
# ---------------------------------------------------------------------------

# Optional: model-backed replies for the AI demo.
# Server-side only. The browser calls /api/chat; the key never leaves the server.
# When unset, or when the model call fails, the local engine answers instead.
# HELLO_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# HELLO_AI_MODEL=claude-opus-5-5

# Public flag telling the browser to try the server route first.
# NEXT_PUBLIC_HELLO_AI_MODE=server

# Optional: real-people mode.
# "memory" = single-process test store for trying the invite / availability /
# friends-of-friends / mutual-accept flow locally with a few browsers. It is
# not persistent and not for production. Anything else = disabled.
# HELLO_HUMAN_MODE=memory
# HELLO_SESSION_SECRET=change-me-32-bytes
# HELLO_FOUNDER_INVITE=ABCD-EFGH   # optional fixed code for the very first account
