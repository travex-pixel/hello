# ---------------------------------------------------------------------------
# HELLO — environment
# Nothing here is required. With no variables set, the app runs the AI demo
# with the local conversation engine and real-people mode reports itself as
# unavailable.
# ---------------------------------------------------------------------------

# Optional: model-written replies for the AI characters (see docs/AI_CONVERSATION.md).
# Server-side only; the browser never sees the key. Without a key the local engine replies.
# ANTHROPIC_API_KEY=sk-ant-...
# HELLO_AI_MODEL=claude-haiku-5-5          # default; claude-sonnet-5-5 for higher quality at ~20x the cost
# HELLO_AI_RATE_PER_MINUTE=20              # per IP address, per server instance
# HELLO_AI_RATE_PER_DAY=400                # per IP address, per server instance
# HELLO_AI_GLOBAL_PER_DAY=5000             # all addresses together, per server instance
# HELLO_AI_FIRST_TOKEN_TIMEOUT_MS=10000
# HELLO_AI_TIMEOUT_MS=25000
# HELLO_AI_MAX_TOKENS=400                 # 1024 by default for Opus/Fable, which always think

# Browser-side, optional:
# NEXT_PUBLIC_HELLO_AI_MODE=local          # force the local engine even when a key is set
# NEXT_PUBLIC_HELLO_TYPING_SCALE=1         # typing pause multiplier; 0 turns it off

# Optional: real people (the mates beta). See docs/HUMAN_MODE.md for setup.
# "supabase" = persistent Postgres + email sign-in codes. All five are required.
# HELLO_HUMAN_MODE=supabase
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable or anon key>
# SUPABASE_SERVICE_ROLE_KEY=<secret or service_role key, server only>
#
# Optional extras:
# HELLO_CONTACT_EMAIL=you@example.com          # shown in the privacy notice
# NEXT_PUBLIC_HELLO_MATE_WAIT_SECONDS=45       # wait before offering AI
# HELLO_DISCOVERY=friends_of_friends           # default: community (any member)
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n..."  # verify the database server
#
# Local only, never in production: "memory" = single process, no email.
# HELLO_HUMAN_MODE=memory
# HELLO_FOUNDER_INVITE=TEST-CODE
